// ~/.config/zellij/themes/modus-operandi.kdl
// Based on the Modus Operandi Emacs theme by Protesilaos Stavrou
// https://github.com/protesilaos/modus-themes

themes {
    modus_operandi {
        // Base colors
        fg 0 0 0         // fg-main: #000000
        bg 255 255 255   // bg-main: #ffffff
        black 0 0 0      // term black: #000000
        red 166 0 0      // red: #a60000
        green 0 104 0    // green: #006800
        yellow 111 85 0  // yellow: #6f5500
        blue 0 49 169    // blue: #0031a9
        magenta 114 16 69 // magenta: #721045
        cyan 0 94 139    // cyan: #005e8b
        white 159 159 159 // border: #9f9f9f (using border for white, adjust if needed)
        orange 136 73 0  // yellow-warmer: #884900 (using warmer yellow for orange)

        // UI elements mapping
        text_unselected {
            base 0 0 0       // fg-main: #000000
            background 255 255 255 // bg-main: #ffffff
            emphasis_0 166 0 0   // red: #a60000
            emphasis_1 0 49 169  // blue: #0031a9
            emphasis_2 0 104 0   // green: #006800
            emphasis_3 114 16 69 // magenta: #721045
        }
        text_selected {
            base 0 0 0       // fg-region: #000000
            background 189 189 189 // bg-region: #bdbdbd
            emphasis_0 166 0 0   // red: #a60000
            emphasis_1 0 49 169  // blue: #0031a9
            emphasis_2 0 104 0   // green: #006800
            emphasis_3 114 16 69 // magenta: #721045
        }
        ribbon_selected {
            base 0 0 0       // fg-main: #000000 (ensure contrast)
            background 138 223 128 // bg-green-intense: #8adf80
            emphasis_0 166 0 0   // red: #a60000
            emphasis_1 0 49 169  // blue: #0031a9
            emphasis_2 111 85 0  // yellow: #6f5500
            emphasis_3 114 16 69 // magenta: #721045
        }
        ribbon_unselected {
            base 88 88 88    // fg-mode-line-inactive: #585858
            background 230 230 230 // bg-mode-line-inactive: #e6e6e6
            emphasis_0 166 0 0   // red: #a60000
            emphasis_1 0 49 169  // blue: #0031a9
            emphasis_2 0 104 0   // green: #006800
            emphasis_3 114 16 69 // magenta: #721045
        }
        table_title {
            base 0 104 0     // green: #006800
            background 255 255 255 // bg-main: #ffffff
            emphasis_0 166 0 0   // red: #a60000
            emphasis_1 0 49 169  // blue: #0031a9
            emphasis_2 111 85 0  // yellow: #6f5500
            emphasis_3 114 16 69 // magenta: #721045
        }
        table_cell_selected { // Same as text_selected
            base 0 0 0
            background 189 189 189
            emphasis_0 166 0 0
            emphasis_1 0 49 169
            emphasis_2 0 104 0
            emphasis_3 114 16 69
        }
        table_cell_unselected { // Same as text_unselected
            base 0 0 0
            background 255 255 255
            emphasis_0 166 0 0
            emphasis_1 0 49 169
            emphasis_2 0 104 0
            emphasis_3 114 16 69
        }
        list_selected { // Same as text_selected
            base 0 0 0
            background 189 189 189
            emphasis_0 166 0 0
            emphasis_1 0 49 169
            emphasis_2 0 104 0
            emphasis_3 114 16 69
        }
        list_unselected { // Same as text_unselected
            base 0 0 0
            background 255 255 255
            emphasis_0 166 0 0
            emphasis_1 0 49 169
            emphasis_2 0 104 0
            emphasis_3 114 16 69
        }
        frame_selected { // Use blue for active frame
            base 0 49 169    // blue: #0031a9
            background 255 255 255 // bg-main: #ffffff (or 0 for terminal default)
            emphasis_0 166 0 0   // red: #a60000
            emphasis_1 0 104 0   // green: #006800
            emphasis_2 111 85 0  // yellow: #6f5500
            emphasis_3 114 16 69 // magenta: #721045
        }
        frame_highlight { // Use warmer yellow for highlight/action
            base 136 73 0    // yellow-warmer: #884900
            background 255 255 255 // bg-main: #ffffff (or 0 for terminal default)
            emphasis_0 136 73 0
            emphasis_1 136 73 0
            emphasis_2 136 73 0
            emphasis_3 136 73 0
        }
        exit_code_success {
            base 0 104 0     // green: #006800
            background 255 255 255 // bg-main: #ffffff (or 0)
            emphasis_0 0 49 169  // blue: #0031a9
            emphasis_1 114 16 69 // magenta: #721045
            emphasis_2 0 94 139  // cyan: #005e8b
            emphasis_3 111 85 0  // yellow: #6f5500
        }
        exit_code_error {
            base 166 0 0     // red: #a60000
            background 255 255 255 // bg-main: #ffffff (or 0)
            emphasis_0 0 49 169  // blue: #0031a9
            emphasis_1 114 16 69 // magenta: #721045
            emphasis_2 0 94 139  // cyan: #005e8b
            emphasis_3 111 85 0  // yellow: #6f5500
        }
        multiplayer_user_colors { // Cycle through distinct accents
            player_1 166 0 0     // red: #a60000
            player_2 0 104 0     // green: #006800
            player_3 111 85 0    // yellow: #6f5500
            player_4 0 49 169    // blue: #0031a9
            player_5 114 16 69   // magenta: #721045
            player_6 0 94 139    // cyan: #005e8b
            player_7 138 41 15   // rust: #8a290f
            player_8 74 58 138   // indigo: #4a3a8a
            player_9 115 28 82   // maroon: #731c52
            player_10 86 105 45  // olive: #56692d
        }
    }
}
