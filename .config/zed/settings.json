// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "disable_ai": true,
  "cli_default_open_behavior": "existing_window",
  "document_symbols": "on",
  "document_folding_ranges": "on",
  "semantic_tokens": "combined",
  "agent_buffer_font_size": 12.0,
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "diff_view_style": "split",
  "outline_panel": {
    "dock": "left",
  },
  "edit_predictions": {
    "provider": "zed",
  },
  "ui_font_size": 12.0,
  "ui_font_family": "Berkeley Mono Variable",
  "buffer_font_family": "Berkeley Mono Variable",
  "buffer_font_size": 12.0,
  "buffer_line_height": {
    "custom": 1.8,
  },
  "terminal": {
    "font_family": "Berkeley Mono Variable",
    "bell": "system",
    "line_height": {
      "custom": 1.8,
    },
  },
  "use_system_window_tabs": true,
  "title_bar": {
    "show_menus": false,
  },
  "inlay_hints": {
    "enabled": false,
  },
  "indent_guides": {
    "enabled": false,
    "background_coloring": "disabled",
    "coloring": "fixed",
  },
  "prettier": {
    "allowed": true,
  },
  "tab_bar": {
    "show": false,
  },
  "use_smartcase_search": true,
  "search": {
    "regex": false,
  },
  "multi_cursor_modifier": "cmd_or_ctrl",
  "agent_servers": {
    "pi-acp": {
      "type": "registry",
    },
    "cursor": {
      "type": "registry",
    },
    "codex-acp": {
      "type": "registry",
    },
    "claude-acp": {
      "type": "registry",
      "default_mode": "bypassPermissions",
      "favorite_models": ["opus"],
    },
    "opencode": {
      "type": "registry",
    },
  },
  "agent": {
    "thinking_display": "preview",
    "sidebar_side": "left",
    "dock": "left",
    "tool_permissions": {
      "default": "allow",
    },
    "commit_message_model": {
      "provider": "openrouter",
      "model": "moonshotai/kimi-k2.6",
    },
    "inline_assistant_model": {
      "provider": "openrouter",
      "model": "moonshotai/kimi-k2.6",
    },
    "default_profile": "write",
    "play_sound_when_agent_done": "always",
    "default_model": {
      "provider": "zed.dev",
      "model": "openai-gpt-5-5",
    },
  },
  "context_servers": {
    // "playwriter": {
    //   "command": "bunx",
    //   "args": ["-y", "playwriter@latest"],
    // },
    //   "next-devtools": {
    //     "command": "bunx",
    //     "args": ["-y", "next-devtools-mcp@latest"],
    //   },
    // "effect docs": {
    //   "command": "bunx",
    //   "args": ["-y", "effect-mcp@latest"],
    // },
    //   "chrome-devtools": {
    //     "command": "bunx",
    //     "args": ["-y", "chrome-devtools-mcp@latest"],
    //   },
    //   "motion": {
    //     "command": "bunx",
    //     "args": ["-y", "motion-ai@latest"],
    //   },
  },
  "theme": {
    "mode": "system",
    "dark": "One Dark",
    "light": "One Light",
  },
  "experimental.theme_overrides": {
    "syntax": {
      "comment": {
        "font_style": "italic",
      },
      "comment.doc": {
        "font_style": "italic",
      },
    },
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false,
  },
  "git_panel": {
    "dock": "left",
    "tree_view": true,
    "default_width": 300.0,
  },
  "project_panel": {
    "dock": "left",
    "default_width": 300.0,
    "file_icons": true,
    "folder_icons": false,
    "git_status": true,
    "auto_reveal_entries": true,
    "auto_fold_dirs": true,
  },
  "excerpt_context_lines": 5,
  "buffer_font_fallbacks": ["Symbols Nerd Font Mono"],
  "vim_mode": true,
  "vim": {
    "use_smartcase_find": true,
  },
  "which_key": { "enabled": true },
  "autosave": "on_focus_change",
  "auto_update": true,
  "soft_wrap": "editor_width",
  "scrollbar": {
    "show": "never",
  },
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "toolbar": {
    "breadcrumbs": true,
    "selections_menu": false,
    "quick_actions": false,
  },
  "languages": {
    "TypeScript": {
      "language_servers": [
        "vtsls",
        "tailwindcss-language-server",
        "!eslint",
        "!typescript-language-server",
      ],
    },
    "TSX": {
      "language_servers": [
        "vtsls",
        "tailwindcss-language-server",
        "!eslint",
        "!typescript-language-server",
      ],
    },
    "JavaScript": {
      "language_servers": [
        "vtsls",
        "tailwindcss-language-server",
        "!eslint",
        "!typescript-language-server",
      ],
    },
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        },
        "typescript": {
          "tsserver": { "maxTsServerMemory": 16184 },
          "preferences": {
            "importModuleSpecifier": "auto",
          },
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
          "suggest": {
            "completeFunctionCalls": true,
          },
          // "preferGoToSourceDefinition": true
        },
        "autoUseWorkspaceTsdk": true,
        "experimental": {
          "completion": {
            "enableServerSideFuzzyMatch": true,
          },
        },
      },
    },
    "tailwindcss-language-server": {
      "settings": {
        "classFunctions": ["cva", "cx", "cn"],
        "experimental": {
          "classRegex": ["[cls|className]\\s\\:\\=\\s\"([^\"]*)"],
        },
      },
    },
  },
}
