// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "ui_font_family": "JetBrains Mono",
  "buffer_line_height": "comfortable",
  "buffer_font_family": "JetBrains Mono",
  "ui_font_size": 13.0,
  "prettier": {
    "allowed": true
  },
  "tab_bar": {
    "show": false
  },
  "agent_buffer_font_size": 13.0,
  "audio": {
    "experimental.auto_microphone_volume": true,
    "experimental.rodio_audio": true
  },
  "use_smartcase_search": true,
  "multi_cursor_modifier": "cmd_or_ctrl",
  "agent_ui_font_size": 13.0,
  "agent_servers": {
    "claude": {
      "default_mode": "bypassPermissions"
    }
  },
  "agent": {
    "default_profile": "write",
    "play_sound_when_agent_done": true,
    "always_allow_tool_actions": true,
    "model_parameters": [],
    "default_model": {
      "provider": "openrouter",
      "model": "anthropic/claude-sonnet-4.5"
    },
    "commit_message_model": {
      "provider": "openrouter",
      "model": "x-ai/grok-code-fast-1"
    }
  },
  "context_servers": {
    "next-devtools": {
      "source": "custom",
      "enabled": true,
      "command": "bunx",
      "args": ["-y", "next-devtools-mcp@latest"]
    },
    "effect docs": {
      "source": "custom",
      "command": "bunx",
      "args": ["-y", "effect-mcp@latest"]
    },
    "motion": {
      "source": "custom",
      "command": "bunx",
      "args": ["-y", "motion-ai@latest"]
    }
  },
  "theme": {
    "mode": "system",
    "dark": "Flexoki Dark",
    "light": "Flexoki Light"
  },
  "experimental.theme_overrides": {
    "syntax": {
      "comment": {
        "font_style": "italic"
      },
      "comment.doc": {
        "font_style": "italic"
      }
    }
  },
  "collaboration_panel": {
    "button": false
  },
  "git_panel": {
    // "dock": "right"
  },
  "project_panel": {
    "file_icons": true,
    "folder_icons": false,
    "git_status": true,
    "auto_reveal_entries": true,
    "auto_fold_dirs": true
  },
  "excerpt_context_lines": 5,
  // "features": {
  //   "edit_prediction_provider": "supermaven"
  // },
  "buffer_font_size": 13.0,
  "buffer_font_fallbacks": ["Symbols Nerd Font Mono"],
  "vim_mode": true,
  "autosave": "on_focus_change",
  "auto_update": true,
  "soft_wrap": "editor_width",
  "scrollbar": {
    "show": "never"
  },
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "toolbar": {
    "breadcrumbs": true,
    "selections_menu": false,
    "quick_actions": false
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "preferences": {
            "importModuleSpecifier": "auto"
          },
          "updateImportsOnFileMove": {
            "enabled": "always"
          },
          "suggest": {
            "completeFunctionCalls": true
          },
          "inlayHints": {
            "enumMemberValues": { "enabled": true },
            "functionLikeReturnTypes": { "enabled": true },
            "parameterNames": { "enabled": "literals" },
            "parameterTypes": { "enabled": true },
            "propertyDeclarationTypes": { "enabled": true },
            "variableTypes": { "enabled": false }
          }
          // "preferGoToSourceDefinition": true
        },
        "autoUseWorkspaceTsdk": true,
        "experimental": {
          "completion": {
            "enableServerSideFuzzyMatch": true
          }
        }
      }
    }
  }
}
