// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "agent_servers": {},
  "agent": {
    "default_profile": "write",
    "play_sound_when_agent_done": true,
    "always_allow_tool_actions": true,
    "model_parameters": [],
    "default_model": {
      "provider": "openai",
      "model": "gpt-5"
    },
    "commit_message_model": {
      "provider": "google",
      "model": "gemini-2.5-flash-preview-05-20"
    }
  },
  "context_servers": {
    "effect docs": {
      "source": "custom",
      "command": "bunx",
      "args": ["-y", "effect-mcp"]
    },
    "motion": {
      "source": "custom",
      "command": "bunx",
      "args": ["-y", "motion-ai"]
    }
  },
  "theme": {
    "mode": "system",
    "dark": "One Dark",
    "light": "One Light"
  },
  "experimental.theme_overrides": {
    "syntax": {
      "comment": {
        "font_style": "italic"
      },
      "comment.doc": {
        "font_style": "italic"
      }
    }
  },
  "collaboration_panel": {
    "button": false
  },
  "git_panel": {
    // "dock": "right"
  },
  "project_panel": {
    "button": true,
    "default_width": 240,
    // "dock": "right",
    "file_icons": true,
    "folder_icons": false,
    "git_status": true,
    "indent_size": 20,
    "auto_reveal_entries": true,
    "auto_fold_dirs": true
  },
  "excerpt_context_lines": 5,
  // "features": {
  //   "edit_prediction_provider": "supermaven"
  // },
  "ui_font_size": 13,
  // "ui_font_family": "Geist Mono",
  // "ui_font_family": "IBM Plex Mono",
  // "ui_font_family": "Berkeley Mono Variable",
  // "ui_font_family": "JetBrains Mono",
  "ui_font_family": "SF Mono",
  "buffer_font_size": 13,

  // "buffer_font_family": "Geist Mono",
  // "buffer_font_family": "IBM Plex Mono",
  // "buffer_font_family": "Berkeley Mono Variable",
  // "buffer_font_family": "JetBrains Mono",
  "buffer_font_family": "SF Mono",
  "buffer_font_fallbacks": ["Symbols Nerd Font Mono"],
  "vim_mode": true,
  "autosave": "on_focus_change",
  "auto_update": true,
  "soft_wrap": "editor_width",
  "scrollbar": {
    // "show": "system"
    // "show": "never"
  },
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "toolbar": {
    "breadcrumbs": true,
    "selections_menu": false,
    "quick_actions": false
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "preferences": {
            "importModuleSpecifier": "auto"
          },
          "updateImportsOnFileMove": {
            "enabled": "always"
          },
          "suggest": {
            "completeFunctionCalls": true
          },
          "inlayHints": {
            "enumMemberValues": { "enabled": true },
            "functionLikeReturnTypes": { "enabled": true },
            "parameterNames": { "enabled": "literals" },
            "parameterTypes": { "enabled": true },
            "propertyDeclarationTypes": { "enabled": true },
            "variableTypes": { "enabled": false }
          }
          // "preferGoToSourceDefinition": true
        },
        "autoUseWorkspaceTsdk": true,
        "experimental": {
          "completion": {
            "enableServerSideFuzzyMatch": true
          }
        }
      }
    }
  }
}
