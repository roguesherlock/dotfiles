[
  {
    "context": "Dock || Terminal || Editor || ProjectPanel",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown"
    }
  },
  {
    "context": "Editor && VimControl && vim_mode == normal && !VimWaiting && !menu",
    "bindings": {
      "space z": "workspace::ToggleZoom"
    }
  },
  {
    "context": "Editor && VimControl && !VimWaiting && !VimObject",
    "bindings": {
      "alt-j": "editor::MoveLineDown",
      "alt-k": "editor::MoveLineUp"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "cmd-t": "workspace::NewTerminal"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-/": "workspace::ToggleRightDock"
    }
  }
]
