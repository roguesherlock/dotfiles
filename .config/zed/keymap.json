[
  {
    "context": "Editor && edit_prediction_conflict",
    "bindings": {
      // Here we bind tab to accept even when there's a language server completion
      // or the cursor isn't at the correct indentation level
      "tab": "editor::AcceptEditPrediction"
    }
  },
  {
    "context": "Dock || Terminal || Editor || ProjectPanel || EmptyPane || SharedScreen || MarkdownPreview",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown"
    }
  },
  {
    "bindings": {
      "cmd-1": "project_panel::ToggleFocus",
      "cmd-2": "git_panel::ToggleFocus",
      "cmd-3": "editor::ToggleFocus",
      "cmd-4": "agent::ToggleFocus",
      "cmd-5": "terminal_panel::Toggle",
      "cmd-6": "debug_panel::ToggleFocus",
      "cmd-ctrl-o": "projects::OpenRecent",
      "cmd-shift-o": "projects::OpenRecent"
    }
  },
  {
    "context": "Editor && VimControl && !VimWaiting && !VimObject",
    "bindings": {
      "alt-j": "editor::MoveLineDown",
      "alt-k": "editor::MoveLineUp",
      "cmd-i": "assistant::InlineAssist"
    }
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      // Put key bindings here if you want them to work in normal & visual mode.
      "s": "vim::PushSneak",
      "shift-s": "vim::PushSneakBackward",
      "ctrl-space": "vim::SelectLargerSyntaxNode",
      "cmd-enter": "workspace::ToggleZoom",
      "j": ["vim::Down", { "display_lines": true }],
      "k": ["vim::Up", { "display_lines": true }],
      "space space": "project_search::ToggleFocus",
      "space g B": "editor::CopyPermalinkToLine",
      "space a c": [
        "agent::NewExternalAgentThread",
        { "agent": "claude_code" }
      ],
      "space a g": ["agent::NewExternalAgentThread", { "agent": "gemini" }],
      "space a o": [
        "agent::NewExternalAgentThread",
        { "agent": "native_agent" }
      ],
      "space a p": ["agent::NewExternalAgentThread", { "agent": "codex" }]
      // "space s s": "project_symbols::Toggle"
    }
  },
  {
    "context": "vim_mode == visual",
    "bindings": {
      "backspace": "vim::SelectSmallerSyntaxNode",
      "shift-s": "vim::PushAddSurrounds"
    }
  },
  {
    "context": "vim_mode == normal",
    "bindings": {
      ",": "editor::ToggleFold",
      "g D": "editor::GoToDefinitionSplit",
      "g b p": "pane::TogglePinTab",
      "g b q": ["pane::CloseAllItems", { "close_pinned": false }],
      "space e": "project_panel::ToggleFocus",
      "space g g": [
        "task::Spawn",
        { "task_name": "lazygit", "reveal_target": "center" }
      ],
      "space g G": "git_panel::ToggleFocus",
      "w h": "workspace::ActivatePaneLeft",
      "w l": "workspace::ActivatePaneRight",
      "w j": "workspace::ActivatePaneDown",
      "w k": "workspace::ActivatePaneUp",
      "w q": "pane::CloseAllItems",
      "w v": "pane::SplitVertical",
      "w m": "workspace::ToggleZoom",
      "space x x": "diagnostics::DeployCurrentFile",
      "space x X": "diagnostics::Deploy",
      "space l R": "editor::RestartLanguageServer",
      "space l d": "editor::ToggleDiagnostics",
      "space t h": "editor::ToggleInlayHints",
      "space b o": "pane::CloseAllItems",
      "shift-e": "editor::Hover",
      "[ [": "editor::GoToPreviousDocumentHighlight",
      "] ]": "editor::GoToNextDocumentHighlight",
      "[ e": ["editor::GoToPreviousDiagnostic", { "severity": "error" }],
      "] e": ["editor::GoToDiagnostic", { "severity": "error" }]
    }
  },
  {
    "context": "vim_mode == insert",
    "bindings": {
      "ctrl-space": "editor::ShowCompletions",
      "tab": "editor::AcceptEditPrediction",
      "ctrl-k": "editor::ShowSignatureHelp"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "cmd-enter": "workspace::ToggleZoom",
      "cmd-t": "workspace::NewTerminal"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-/": "workspace::ToggleRightDock"
    }
  },
  {
    "context": "GitPanel && menu",
    "bindings": {
      "ctrl-c": "git::CheckoutBranch",
      "ctrl-p": "git::Pull",
      "ctrl-shift-p": "git::Push",
      "ctrl-j": "git_panel::FocusEditor",
      "q": "workspace::CloseActiveDock"
    }
  },
  {
    "context": "GitPanel > Editor",
    "bindings": {
      "ctrl-c": "git::CheckoutBranch",
      "ctrl-p": "git::Pull",
      "ctrl-shift-p": "git::Push",
      "ctrl-k": "git_panel::FocusChanges"
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "q": "workspace::CloseActiveDock"
    }
  },
  {
    "context": "Diagnostics > Editor && vim_mode == normal",
    "bindings": {
      "q": "pane::CloseActiveItem"
    }
  }
]
