# font-family = "Iosevka Term"
# font-family = "Geist Mono"
# font-family = "Maple Mono"
# font-family = "Berkeley Mono Variable"
font-size = 13
font-thicken = true
font-thicken-strength = 30
adjust-cell-height = 25%
adjust-underline-position = 6
adjust-underline-thickness = 40%
adjust-cursor-thickness = 150%
window-padding-x = 0
window-padding-y = 0
window-padding-balance = true
theme = light:Github-Light-High-Contrast,dark:Black Metal
macos-option-as-alt = true
macos-non-native-fullscreen = true
window-colorspace = display-p3
# background-opacity = 0.90
# background-blur-radius = 20
window-save-state = always
unfocused-split-opacity=0.85
auto-update-channel=tip
custom-shader=./shaders/cursor_smear.glsl
minimum-contrast=2

quick-terminal-position = center
quick-terminal-animation-duration = 0
keybind = shift+enter=text:\n
keybind = super+o=toggle_quick_terminal

keybind = super+h=goto_split:previous
keybind = super+j=goto_split:down
keybind = super+k=goto_split:up
keybind = super+l=goto_split:next
keybind = super+l=goto_split:next
keybind = super+enter=toggle_split_zoom
keybind = super+shift+enter=toggle_fullscreen

