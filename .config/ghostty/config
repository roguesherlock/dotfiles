# font-family = "Maple Mono"
# font-family = "Input Mono Narrow"
# font-family = "JuliaMono"
# font-family = "Geist Mono"
# font-variation = wght=450
# font-variation-bold = wght=800
# font-variation-italic = wght=450
# font-variation-bold-italic = wght=800
font-size = 14
adjust-cell-height = 20%
# window-padding-x = 0
# window-padding-y = 0
window-padding-balance = true
theme = catppuccin-frappe
macos-option-as-alt = true
macos-non-native-fullscreen = true
window-colorspace = display-p3
# TODO: enable this when the next zellij release is out
background-opacity = 0.85
background-blur-radius = 26
# macos-titlebar-style = tabs
window-save-state = always
auto-update = download

# custom-shader = ./shaders/retro-terminal.glsl
# custom-shader = ./shaders/just-snow.glsl
# custom-shader = ./shaders/starfield.glsl
# custom-shader = ./shaders/negative.glsl

