font-family = "Lilex"
# font-family = "0xProto"
font-size = 12
# font-thicken = true
# font-thicken-strength = 20
adjust-cell-height = 50%
adjust-underline-position = 5
adjust-underline-thickness = 30%
adjust-cursor-thickness = 150%
cursor-color = cell-foreground
window-padding-x = 0
window-padding-y = 0
window-padding-balance = true
theme = modus_dark.conf
macos-titlebar-style = tabs
# macos-titlebar-style = transparent
macos-option-as-alt = true
macos-non-native-fullscreen = true
window-colorspace = display-p3
window-save-state = always
unfocused-split-opacity=0.75
auto-update-channel=tip
# background-opacity=0.85
# background-blur=true
# custom-shader=shaders/cursor_warp.glsl  # disabled - battery drain

quick-terminal-position = center
quick-terminal-animation-duration = 0
keybind = super+o=toggle_quick_terminal

keybind = performable:super+h=goto_split:previous
keybind = performable:super+j=goto_split:down
keybind = performable:super+k=goto_split:up
keybind = performable:super+l=goto_split:next
keybind = super+enter=toggle_split_zoom
keybind = super+shift+enter=toggle_fullscreen


